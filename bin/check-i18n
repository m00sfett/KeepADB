#!/usr/bin/env python3
"""Find strings that remain identical to the English reference value
(values/strings.xml) in a locale variant. The most common cause is a new
locale file created with the English placeholder value, leaving the key
untranslated. A key-existence-only diff (Android Lint "MissingTranslation")
does not detect this because the key exists; only its value is accidentally
identical.

Exit code 0: no unexpected findings. Exit code 1: at least one string is
identical to the reference and is not on the allowlist.

Detection limit (#238):
The script proves only that no parsed `<string>` key in a locale file has a
value identical to the English reference (unless it is in ALLOWLIST). It
therefore rules out copy-and-paste copies of the reference, and nothing else.
It explicitly does NOT prove that a translation is correct, complete, or in
the right language. Two known blind spots remain:

1. Partial translation: A string with an untranslated English fragment left
   in place differs from the reference and is therefore not reported.
2. Wrong locale: Text in the wrong language in a values-xx file (for example,
   Spanish text in values-it/strings.xml) counts as "different from the
   reference" and is therefore incorrectly treated as translated.

For ./bin/verify, check-i18n is a necessary but insufficient gate. It rules
out copy-and-paste, but not all translation errors. Case 2 is not checked
automatically; it must be checked manually when adding locales.

A heuristic for case 1 was evaluated (#238): report Latin word sequences
outside an allowlist in non-Latin target locales (ar, hi, ja, ko, ru, uk,
zh-rCN, zh-rTW). A prototype run against the current content produced 215
findings across 8 locales and 158 reference keys, almost entirely noise from
shell commands, permission constants (WRITE_SECURE_SETTINGS), format
placeholders (host:port, IP addresses, HTTP methods), and product/protocol
terms (USB-ADB, Wi-Fi ADB, Tailnet). An allowlist large enough to provide a
useful signal-to-noise ratio would need an exception for nearly every
technical string, making it more costly than the benefit. Decision: not
implemented; see AGENTS.md.
"""

import glob
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
REFERENCE = REPO_ROOT / "app/src/main/res/values/strings.xml"
LANG_GLOB = str(REPO_ROOT / "app/src/main/res/values-*/strings.xml")

# Sentinel for keys that are legitimately identical in *every* language.
ALL_LANGUAGES = "*"

# Keys whose value may legitimately match the English reference, mapped to the
# languages where that is expected. Use ALL_LANGUAGES only for values that carry
# no natural language at all (brand names, shell commands, pure format strings);
# everything else lists its languages explicitly, so that the same word staying
# untranslated in a *different* language still shows up as a finding.
#
# The explicit lists matter: several loanwords are kept verbatim in most target
# languages but genuinely translated in some (Hindi and Korean transliterate
# "Webhook", Chinese glosses "Keep-Alive"). A key-wide exemption would silently
# hide a future regression in exactly those languages.
ALLOWLIST = {
    # -- No natural language in the value at all --
    "setup_command": ALL_LANGUAGES,              # literal shell command (adb shell pm grant ...)
    "setup_command_multi": ALL_LANGUAGES,        # literal shell command (adb -s <serial> shell pm grant ...)
    "tile_state_connected_format": ALL_LANGUAGES,  # pure format string "%1$s:%2$d"
    "endpoint_format": ALL_LANGUAGES,            # pure format string "Endpoint: %1$s:%2$d"
    "notification_text_active": ALL_LANGUAGES,   # pure format string "Port %1$d @ %2$s"
    "settings_webhook_url_hint": ALL_LANGUAGES,  # technical URL example, not prose
    "settings_website_link": ALL_LANGUAGES,      # domain name, not prose
    "issue_report_placeholder_steps": ALL_LANGUAGES,  # deliberately empty string
    "settings_section_usb_adb": ALL_LANGUAGES,   # protocol term "USB-ADB", not prose (#520)
    "transport_vpn_label": ALL_LANGUAGES,        # "ADB via VPN": protocol terms, not prose (#538, #877)
    "transport_usb_label": ALL_LANGUAGES,        # protocol term "USB", not prose (#538)
    "usb_notification_enable_wlan_handover": ALL_LANGUAGES,  # product term "Wifi-ADB" only:
    # One UI gives each of the three USB notification actions an equal ~8-character slot,
    # so the handover action is just the term itself in every language (#593). Renamed from
    # "WLAN-ADB" to "Wifi-ADB" for the cross-language glossary in #599; still 8 characters,
    # still identical across all locales.

    # -- Loanwords and technical terms, cleared per language (#236) --
    # "Webhook": kept verbatim inside otherwise translated surroundings
    # ("Синхронизация Webhook", "Webhook 同期", "مزامنة Webhook"). Hindi and
    # Korean transliterate it instead and are therefore NOT listed here.
    "webhook_status_title": {
        "ar", "de", "es", "fr", "in", "it", "ja", "nl",
        "pl", "pt", "ru", "tr", "uk", "vi", "zh-rCN", "zh-rTW",
    },
    # "Keep-Alive": TCP/HTTP term used verbatim. Chinese glosses it as
    # "保持常驻 (Keep-Alive)" and is therefore not listed.
    "settings_section_keep_alive": {
        "ar", "fr", "hi", "in", "it", "ja", "ko",
        "nl", "pl", "pt", "ru", "tr", "uk", "vi",
    },
    "settings_webhook_url_label": {"ja"},   # "Webhook URL" is the idiomatic Japanese form
    "settings_section_version": {"de", "fr"},   # "Version" is the correct German and French word
    "background_location_dialog_later": {"nl"},  # "Later" is the correct Dutch word (#644)
    "onboarding_later": {"nl"},                  # "Later" is the correct Dutch word (#761)
    "onboarding_badge_optional": {"de"},         # "Optional" is the correct German word (#767)
    "settings_section_general": {"es"},         # "General" is the correct Spanish word
    "settings_section_notification": {"fr"},    # "Notification" is the correct French word
    "usb_profile_hostname_hint": {"de"},        # "Hostname (optional)" is correct German (cf. nl "Hostnaam (optioneel)")
    "network_manage_title": {"nl"},             # "Access points" is the Dutch loanword used throughout the nl strings (#654)
    "network_decision_ap_label": {"nl"},        # "Access point (BSSID)": same loanword in nl (#766)

    # -- Band labels (#714): the unit "GHz" and the digits are written the same way in most --
    # languages; ru, uk and ar write the unit in their own script and are therefore not listed
    # for the 5 and 6 GHz labels. The 2.4 GHz label additionally differs by decimal separator
    # (comma in most European languages), so only the languages that keep the point are listed.
    "network_bssid_with_band": ALL_LANGUAGES,    # pure format string "%1$s (%2$s)"
    "network_band_5": {
        "de", "es", "fr", "hi", "in", "it", "ja", "ko", "nl",
        "pl", "pt", "tr", "vi", "zh-rCN", "zh-rTW",
    },
    "network_band_6": {
        "de", "es", "fr", "hi", "in", "it", "ja", "ko", "nl",
        "pl", "pt", "tr", "vi", "zh-rCN", "zh-rTW",
    },
    "network_band_24": {"hi", "ja", "ko", "zh-rCN", "zh-rTW"},  # these keep the decimal point
}

STRING_RE = re.compile(r'<string\b([^>]*)>(.*?)</string>', re.S)
PLURALS_RE = re.compile(r'<plurals\b([^>]*)>(.*?)</plurals>', re.S)
STRING_ARRAY_RE = re.compile(r'<string-array\b([^>]*)>(.*?)</string-array>', re.S)
ITEM_RE = re.compile(r'<item\s+quantity="([^"]+)"[^>]*>(.*?)</item>', re.S)
ARRAY_ITEM_RE = re.compile(r'<item[^>]*>(.*?)</item>', re.S)


def attr(attrs: str, name: str):
    m = re.search(rf'{name}="([^"]*)"', attrs)
    return m.group(1) if m else None


def parse_strings(path: Path) -> tuple[dict, set]:
    """Parses <string>, <plurals> (per quantity) and <string-array> (per item)
    into a flat dict of {display_key: value}, e.g. "greeting", "days[one]" or
    "colors[0]". Also returns the set of base keys marked
    translatable="false" -- Android never offers those for translation, so
    they are excluded from the check entirely."""
    content = path.read_text(encoding="utf-8")
    units = {}
    translatable_false = set()

    for attrs, body in STRING_RE.findall(content):
        name = attr(attrs, "name")
        if name is None:
            continue
        if attr(attrs, "translatable") == "false":
            translatable_false.add(name)
        units[name] = body

    for attrs, body in PLURALS_RE.findall(content):
        name = attr(attrs, "name")
        if name is None:
            continue
        if attr(attrs, "translatable") == "false":
            translatable_false.add(name)
        for quantity, value in ITEM_RE.findall(body):
            units[f"{name}[{quantity}]"] = value

    for attrs, body in STRING_ARRAY_RE.findall(content):
        name = attr(attrs, "name")
        if name is None:
            continue
        if attr(attrs, "translatable") == "false":
            translatable_false.add(name)
        for index, value in enumerate(ARRAY_ITEM_RE.findall(body)):
            units[f"{name}[{index}]"] = value

    return units, translatable_false


def base_key(display_key: str) -> str:
    """Strips a "[quantity]"/"[index]" suffix back to the ALLOWLIST/reference key."""
    return display_key.split("[", 1)[0]


def main() -> int:
    if not REFERENCE.exists():
        print(f"Referenzdatei fehlt: {REFERENCE}", file=sys.stderr)
        return 2

    reference, ref_translatable_false = parse_strings(REFERENCE)
    findings = []
    # Tracks, per ALLOWLIST key, which languages actually produced a
    # would-be finding that the allowlist suppressed -- used below to
    # detect orphaned allowlist entries.
    allowlist_hits = {key: set() for key in ALLOWLIST}

    for path_str in sorted(glob.glob(LANG_GLOB)):
        path = Path(path_str)
        lang = path.parent.name.removeprefix("values-")
        values, _lang_translatable_false = parse_strings(path)
        for display_key, value in values.items():
            key = base_key(display_key)
            if key in ref_translatable_false:
                continue
            if display_key not in reference:
                continue
            ref_value = reference[display_key].strip()
            if len(ref_value) <= 1:
                continue
            if ref_value != value.strip():
                continue

            allowed = ALLOWLIST.get(key)
            if allowed is ALL_LANGUAGES:
                allowlist_hits[key].add(ALL_LANGUAGES)
                continue
            if allowed is not None and lang in allowed:
                allowlist_hits[key].add(lang)
                continue
            findings.append((lang, display_key, ref_value))

    orphans = []
    for key, allowed in ALLOWLIST.items():
        if key not in ref_translatable_false and not any(base_key(k) == key for k in reference):
            orphans.append(f"{key}: Key existiert nicht (mehr) in der Referenz")
            continue
        hits = allowlist_hits[key]
        if allowed is ALL_LANGUAGES:
            if ALL_LANGUAGES not in hits:
                orphans.append(f"{key}: ALL_LANGUAGES erzeugt in keiner Sprache mehr einen Treffer")
        else:
            for lang in sorted(allowed - hits):
                orphans.append(f"{key}: Sprache {lang!r} erzeugt keinen Treffer mehr")

    exit_code = 0

    if findings:
        exit_code = 1
        print(f"check-i18n: {len(findings)} vermutlich unübersetzte(r) String(s) gefunden:\n")
        for lang, key, ref_value in findings:
            print(f"  values-{lang}/strings.xml: {key} = {ref_value!r}")
        print(
            "\nWert ist wortidentisch zum englischen Original (values/strings.xml). "
            "Entweder übersetzen, oder falls in genau dieser Sprache absichtlich "
            "identisch (Lehnwort, Fachbegriff, gleiches Wort): Key in ALLOWLIST in "
            "bin/check-i18n um diese Sprache ergänzen, mit Begründung. "
            "ALL_LANGUAGES nur für Werte ohne natürliche Sprache (Markenname, "
            "Shell-Befehl, reiner Format-String)."
        )
    else:
        print("check-i18n: keine unübersetzten (kopierten) Strings gefunden.")

    if orphans:
        print(f"\ncheck-i18n: {len(orphans)} verwaiste(r) ALLOWLIST-Eintrag/Einträge:\n", file=sys.stderr)
        for orphan in orphans:
            print(f"  {orphan}", file=sys.stderr)
        print(
            "\nDieser Eintrag deckt aktuell nichts (mehr) ab -- Key umbenannt, gelöscht, "
            "oder inzwischen tatsächlich übersetzt. ALLOWLIST-Eintrag entfernen oder anpassen.",
            file=sys.stderr,
        )

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
