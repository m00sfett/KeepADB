#!/usr/bin/env python3
"""Findet Strings, die in einer Sprachvariante wortidentisch zum englischen
Referenzwert (values/strings.xml) geblieben sind -- die häufigste Ursache
dafür: eine neue Sprachdatei wurde mit dem englischen Platzhalterwert
angelegt und der Key nie tatsächlich übersetzt. Ein reiner Key-Existenz-Diff
(Android Lint "MissingTranslation") erkennt das nicht, weil der Key ja
vorhanden ist -- nur der Wert stimmt zufällig/versehentlich überein.

Exit-Code 0: keine unerwarteten Treffer. Exit-Code 1: mindestens ein
String ist identisch zur Referenz und steht nicht auf der Allowlist.
"""

import glob
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
REFERENCE = REPO_ROOT / "app/src/main/res/values/strings.xml"
LANG_GLOB = str(REPO_ROOT / "app/src/main/res/values-*/strings.xml")

# Sentinel for keys that are legitimately identical in *every* language.
ALL_LANGUAGES = "*"

# Keys whose value may legitimately match the English reference, mapped to the
# languages where that is expected. Use ALL_LANGUAGES only for values that carry
# no natural language at all (brand names, shell commands, pure format strings);
# everything else lists its languages explicitly, so that the same word staying
# untranslated in a *different* language still shows up as a finding.
#
# The explicit lists matter: several loanwords are kept verbatim in most target
# languages but genuinely translated in some (Hindi and Korean transliterate
# "Webhook", Chinese glosses "Keep-Alive"). A key-wide exemption would silently
# hide a future regression in exactly those languages.
ALLOWLIST = {
    # -- No natural language in the value at all --
    "app_name": ALL_LANGUAGES,                   # brand name "KeepADB"
    "title_keepadb": ALL_LANGUAGES,              # brand name "KeepADB"
    "setup_command": ALL_LANGUAGES,              # literal shell command (adb shell pm grant ...)
    "tile_label": ALL_LANGUAGES,                 # @string reference, not prose
    "tile_state_connected_format": ALL_LANGUAGES,  # pure format string "%1$s:%2$d"
    "endpoint_format": ALL_LANGUAGES,            # pure format string "Endpoint: %1$s:%2$d"
    "notification_text_active": ALL_LANGUAGES,   # pure format string "Port %1$d @ %2$s"
    "settings_webhook_url_hint": ALL_LANGUAGES,  # technical URL example, not prose
    "issue_report_placeholder_steps": ALL_LANGUAGES,  # deliberately empty string

    # -- Loanwords and technical terms, cleared per language (#236) --
    # "Webhook": kept verbatim inside otherwise translated surroundings
    # ("Синхронизация Webhook", "Webhook 同期", "مزامنة Webhook"). Hindi and
    # Korean transliterate it instead and are therefore NOT listed here.
    "webhook_status_title": {
        "ar", "de", "es", "fr", "id", "it", "ja", "nl",
        "pl", "pt", "ru", "tr", "uk", "vi", "zh-rCN", "zh-rTW",
    },
    # "Keep-Alive": TCP/HTTP term used verbatim. Chinese glosses it as
    # "保持常驻 (Keep-Alive)" and is therefore not listed.
    "settings_section_keep_alive": {
        "ar", "fr", "hi", "id", "it", "ja", "ko",
        "nl", "pl", "pt", "ru", "tr", "uk", "vi",
    },
    "settings_webhook_url_label": {"ja"},   # "Webhook URL" is the idiomatic Japanese form
    "settings_section_version": {"de", "fr"},   # "Version" is the correct German and French word
    "settings_section_general": {"es"},         # "General" is the correct Spanish word
    "settings_section_notification": {"fr"},    # "Notification" is the correct French word
    "usb_profile_hostname_hint": {"de"},        # "Hostname (optional)" is correct German (cf. nl "Hostnaam (optioneel)")
}

STRING_RE = re.compile(r'<string\b([^>]*)>(.*?)</string>', re.S)
PLURALS_RE = re.compile(r'<plurals\b([^>]*)>(.*?)</plurals>', re.S)
STRING_ARRAY_RE = re.compile(r'<string-array\b([^>]*)>(.*?)</string-array>', re.S)
ITEM_RE = re.compile(r'<item\s+quantity="([^"]+)"[^>]*>(.*?)</item>', re.S)
ARRAY_ITEM_RE = re.compile(r'<item[^>]*>(.*?)</item>', re.S)


def attr(attrs: str, name: str):
    m = re.search(rf'{name}="([^"]*)"', attrs)
    return m.group(1) if m else None


def parse_strings(path: Path) -> tuple[dict, set]:
    """Parses <string>, <plurals> (per quantity) and <string-array> (per item)
    into a flat dict of {display_key: value}, e.g. "greeting", "days[one]" or
    "colors[0]". Also returns the set of base keys marked
    translatable="false" -- Android never offers those for translation, so
    they are excluded from the check entirely."""
    content = path.read_text(encoding="utf-8")
    units = {}
    translatable_false = set()

    for attrs, body in STRING_RE.findall(content):
        name = attr(attrs, "name")
        if name is None:
            continue
        if attr(attrs, "translatable") == "false":
            translatable_false.add(name)
        units[name] = body

    for attrs, body in PLURALS_RE.findall(content):
        name = attr(attrs, "name")
        if name is None:
            continue
        if attr(attrs, "translatable") == "false":
            translatable_false.add(name)
        for quantity, value in ITEM_RE.findall(body):
            units[f"{name}[{quantity}]"] = value

    for attrs, body in STRING_ARRAY_RE.findall(content):
        name = attr(attrs, "name")
        if name is None:
            continue
        if attr(attrs, "translatable") == "false":
            translatable_false.add(name)
        for index, value in enumerate(ARRAY_ITEM_RE.findall(body)):
            units[f"{name}[{index}]"] = value

    return units, translatable_false


def base_key(display_key: str) -> str:
    """Strips a "[quantity]"/"[index]" suffix back to the ALLOWLIST/reference key."""
    return display_key.split("[", 1)[0]


def main() -> int:
    if not REFERENCE.exists():
        print(f"Referenzdatei fehlt: {REFERENCE}", file=sys.stderr)
        return 2

    reference, ref_translatable_false = parse_strings(REFERENCE)
    findings = []

    for path_str in sorted(glob.glob(LANG_GLOB)):
        path = Path(path_str)
        lang = path.parent.name.removeprefix("values-")
        values, _lang_translatable_false = parse_strings(path)
        for display_key, value in values.items():
            key = base_key(display_key)
            if key in ref_translatable_false:
                continue
            allowed = ALLOWLIST.get(key)
            if allowed is ALL_LANGUAGES or (allowed is not None and lang in allowed):
                continue
            if display_key not in reference:
                continue
            ref_value = reference[display_key].strip()
            if len(ref_value) <= 1:
                continue
            if ref_value == value.strip():
                findings.append((lang, display_key, ref_value))

    if not findings:
        print("check-i18n: keine unübersetzten (kopierten) Strings gefunden.")
        return 0

    print(f"check-i18n: {len(findings)} vermutlich unübersetzte(r) String(s) gefunden:\n")
    for lang, key, ref_value in findings:
        print(f"  values-{lang}/strings.xml: {key} = {ref_value!r}")
    print(
        "\nWert ist wortidentisch zum englischen Original (values/strings.xml). "
        "Entweder übersetzen, oder falls in genau dieser Sprache absichtlich "
        "identisch (Lehnwort, Fachbegriff, gleiches Wort): Key in ALLOWLIST in "
        "bin/check-i18n um diese Sprache ergänzen, mit Begründung. "
        "ALL_LANGUAGES nur für Werte ohne natürliche Sprache (Markenname, "
        "Shell-Befehl, reiner Format-String)."
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
