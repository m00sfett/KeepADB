#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

echo "==> [1/5] Checking git diff..."
git diff --check

echo "==> [2/5] Checking i18n (copy-pasted-instead-of-translated strings)..."
python3 bin/check-i18n

echo "==> [3/5] Running tests, lint and debug build..."
export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk}"
./gradlew testDebugUnitTest lintDebug assembleDebug

echo "==> [4/5] Building release APK..."
./gradlew assembleRelease

echo "==> [5/5] Checking debug/release brand labels in the built APKs..."
python3 bin/check-variant-labels

echo "==> Verification completed successfully!"
