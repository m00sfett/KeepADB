<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive webhook configuration, endpoints, and device-bound heartbeat timestamps -->
        <exclude domain="sharedpref" path="keepadb_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="keepadb_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
