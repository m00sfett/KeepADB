<?xml version="1.0" encoding="utf-8"?>
<!-- #954: static launcher shortcuts, in this order. The launcher starts them with the identity of
     this app, so the activities stay unexported. The debug build overlays this file with the suffixed package id. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="toggle_wifi_adb"
        android:enabled="true"
        android:icon="@drawable/ic_keepadb"
        android:shortcutShortLabel="@string/shortcut_toggle_short"
        android:shortcutLongLabel="@string/shortcut_toggle_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="de.hohnepeople.keepadb"
            android:targetClass="de.hohnepeople.keepadb.KeepADBToggleShortcutActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="timer_wifi_adb"
        android:enabled="true"
        android:icon="@drawable/ic_timer"
        android:shortcutShortLabel="@string/shortcut_timer_short"
        android:shortcutLongLabel="@string/shortcut_timer_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="de.hohnepeople.keepadb"
            android:targetClass="de.hohnepeople.keepadb.KeepADBTimerShortcutActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="wifi_networks"
        android:enabled="true"
        android:icon="@drawable/ic_wifi"
        android:shortcutShortLabel="@string/networks_title"
        android:shortcutLongLabel="@string/networks_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="de.hohnepeople.keepadb"
            android:targetClass="de.hohnepeople.keepadb.NetworkListActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings_gear"
        android:shortcutShortLabel="@string/action_settings"
        android:shortcutLongLabel="@string/action_settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="de.hohnepeople.keepadb"
            android:targetClass="de.hohnepeople.keepadb.SettingsActivity" />
    </shortcut>
</shortcuts>
