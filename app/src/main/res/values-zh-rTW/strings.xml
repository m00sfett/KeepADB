    <string name="setup_title">首次設定</string>
    <string name="setup_body">請啟用 USB 偵錯並透過 USB 將此裝置連接到電腦。先在電腦上執行 "adb devices" 列出已連接的裝置與模擬器，然後使用其中顯示的正確序號。</string>
    <string name="setup_command">adb shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
