<?xml version="1.0" encoding="utf-8"?>
<!-- #763: the one dialog that can turn the force mode on. Duration first, then the warning block
     that grows with it, then (only without an end time) the acknowledgment the confirm button
     waits for. Stacked full-width buttons: the labels are long and large text must not clip. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/force_dialog_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/force_dialog_intro"
            android:textColor="@color/night_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/force_dialog_duration_label"
            android:textColor="@color/title_yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/force_dialog_spans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/force_span_1h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:text="@string/force_duration_1h"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/force_span_24h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:text="@string/force_duration_24h"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/force_span_7d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:text="@string/force_duration_7d"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/force_span_30d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:text="@string/force_duration_30d"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/force_span_unlimited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:text="@string/force_duration_unlimited"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/force_dialog_warning_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel_advice"
            android:orientation="vertical">

            <TextView
                android:id="@+id/force_dialog_warning_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:text="@string/force_warning_all"
                android:textColor="@color/night_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/force_dialog_warning_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:text="@string/force_warning_days"
                android:textColor="@color/night_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/force_dialog_warning_unlimited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:text="@string/force_warning_unlimited"
                android:textColor="@color/title_yellow"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/force_dialog_ack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:minHeight="48dp"
            android:text="@string/force_unlimited_ack"
            android:textColor="@color/night_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/force_dialog_keepalive_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:text="@string/force_keepalive_hint"
            android:textColor="@color/night_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/force_dialog_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/title_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/force_dialog_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@android:string/cancel"
            android:textColor="@color/text_yellow"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
