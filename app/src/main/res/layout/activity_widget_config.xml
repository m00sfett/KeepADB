<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <!-- #912: the settings of one placed control widget (main action, order, details). Opened by
         the launcher when the widget is placed or reconfigured, and from the widget itself. -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_red"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_header"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/widget_config_title"
            android:textColor="@color/title_yellow"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/widget_config_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/widget_config_primary"
                android:textColor="@color/title_yellow"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- One radio button per action; the labels are set in code from the action names. -->
            <RadioGroup
                android:id="@+id/widget_config_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/widget_config_order"
                android:textColor="@color/title_yellow"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- One row per action with move up / move down, built in code. -->
            <LinearLayout
                android:id="@+id/widget_config_order_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Switch
                android:id="@+id/widget_config_hide_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:text="@string/widget_config_hide_details"
                android:textColor="@color/text_yellow"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_config_hide_details_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/widget_config_hide_details_global"
                android:textColor="@color/night_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/widget_config_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/widget_config_save"
                style="@style/Widget.KeepADB.Button.Primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
