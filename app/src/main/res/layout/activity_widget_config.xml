<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <!-- #912: the settings of one placed control widget (main action, order, details). Opened by
         the launcher when the widget is placed or reconfigured, and from the widget itself. -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_red"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_header"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/widget_config_title"
            android:textColor="@color/title_yellow"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The body takes the bottom inset (navigation bar), so the Save button below the scrolling
         part is always on the screen, whatever the screen height. -->
    <LinearLayout
        android:id="@+id/widget_config_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <ScrollView
        android:id="@+id/widget_config_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="32dp"
        android:fillViewport="true"
        android:requiresFadingEdge="vertical">

        <!-- The Save button is outside this ScrollView, so nothing is ever drawn under it; the
             content ends 24 dp above the end of the scrolling part and the fading edge shows that
             more is below while the last row is still out of sight (#912 round 3). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/widget_config_primary"
                android:textColor="@color/title_yellow"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- One radio button per action; the labels are set in code from the action names. -->
            <RadioGroup
                android:id="@+id/widget_config_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/widget_config_order"
                android:textColor="@color/title_yellow"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- One row per action with move up / move down, built in code. -->
            <LinearLayout
                android:id="@+id/widget_config_order_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <Switch
                android:id="@+id/widget_config_hide_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:text="@string/widget_config_hide_details"
                android:textColor="@color/text_yellow"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_config_hide_details_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/widget_config_hide_details_global"
                android:textColor="@color/night_muted"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

        <Button
            android:id="@+id/widget_config_save"
            style="@style/Widget.KeepADB.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/widget_config_save" />
    </LinearLayout>
</LinearLayout>
