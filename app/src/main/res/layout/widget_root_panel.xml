<?xml version="1.0" encoding="utf-8"?>
<!-- #912: about 4x2 and larger: the main control over two rows on the left, two pills on the
     right (they grow with the height), and under them one status line (as high as its text, at
     least 48 dp) with the round settings button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_root"
    android:padding="@dimen/widget_gap_half"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/widget_slot_hero"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical">

    <FrameLayout
        android:id="@+id/widget_slot_a"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/widget_slot_b"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_status_text"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_customize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_widget_gear"
            android:clickable="true"
            android:contentDescription="@string/widget_config_title"
            android:focusable="true"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_gear" />
    </LinearLayout>
</LinearLayout>
