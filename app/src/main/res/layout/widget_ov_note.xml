<?xml version="1.0" encoding="utf-8"?>
<!-- #913: the history line of the compact overview card ("Last delivery 14:03"), indented under
     the delivery row and quieter than the state, so it never reads as the current claim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="0.8"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal"
    android:paddingStart="25dp">

    <TextView
        android:id="@+id/widget_ov_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="0.5sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_soft" />
</LinearLayout>
