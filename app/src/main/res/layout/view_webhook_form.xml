<?xml version="1.0" encoding="utf-8"?>
<!-- The register-webhook form (#768, extracted from the Settings): shared by the Settings and the
     setup assistant, both driven by KeepADBWebhookForm. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <Switch
        android:id="@+id/settings_webhook_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:fontFamily="sans-serif-condensed"
        android:text="@string/settings_webhook_toggle"
        android:textColor="@color/text_yellow"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/settings_webhook_subtext"
        android:textColor="@color/night_muted"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="@string/settings_webhook_url_label"
        android:textColor="@color/night_text"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/settings_webhook_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:fontFamily="monospace"
        android:hint="@string/settings_webhook_url_hint"
        android:inputType="textUri"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/night_text"
        android:textColorHint="@color/night_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/settings_webhook_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif"
        android:textColor="@color/link_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/settings_webhook_cleartext_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="sans-serif"
        android:text="@string/settings_webhook_cleartext_warning"
        android:textColor="@color/text_yellow"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/settings_webhook_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_webhook_btn_clear"
            android:textColor="@color/text_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_webhook_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_webhook_btn_save"
            android:textColor="@color/title_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</merge>
