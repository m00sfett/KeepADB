<?xml version="1.0" encoding="utf-8"?>
<!-- #912: one control of the widget. The label names it, the state says in words what it is now;
     KeepADBWidget sets both, the outline and the tap target. A text that does not fit is cut with an
     ellipsis, the full wording is in the tile's content description. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="2dp"
    android:layout_weight="1"
    android:background="@drawable/bg_widget_tile_off"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/widget_tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_yellow"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_tile_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/night_text"
        android:textSize="11sp" />
</LinearLayout>
