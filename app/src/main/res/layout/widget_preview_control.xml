<?xml version="1.0" encoding="utf-8"?>
<!-- #912: the picker preview (Android 12+), sized for the default 2x1: the main control with its
     port over the yellow gradient and one square symbol button, as the 2x1 widget shows them.
     Static sample states; the real widget reads the live ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_root"
    android:orientation="horizontal"
    android:padding="@dimen/widget_gap_half">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_hero_on"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_adb"
            android:tint="@color/widget_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=":38203"
            tools:ignore="HardcodedText"
            android:textColor="@color/widget_ink"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_gap_half"
        android:background="@drawable/bg_widget_pill_on"
        android:gravity="center">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_keep_alive"
            android:tint="@color/widget_ink" />
    </LinearLayout>
</LinearLayout>
