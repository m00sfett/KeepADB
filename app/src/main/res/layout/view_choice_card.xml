<?xml version="1.0" encoding="utf-8"?>
<!-- #761: one choice card of the setup assistant. The whole card is the touch target and the one
     accessibility node (OnboardingChoiceCard gives it the radio-button role and the checked
     state); the radio indicator, the badge and the body are not focus targets of their own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/choice_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_choice_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <RadioButton
        android:id="@+id/choice_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/choice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/night_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/choice_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-condensed"
            android:importantForAccessibility="no"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/choice_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/night_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
