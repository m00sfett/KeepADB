<?xml version="1.0" encoding="utf-8"?>
<!-- #912: the control widget for the sizes with status lines (tall 2x2 and 4x2). The tiles keep
     their own, flat height; the room that is left goes to the status box. The box shows the
     endpoint (one line, cut in the middle if it must be so the port stays readable) or the reason
     the state is what it is (up to two lines), and the webhook state (one line). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_root"
    android:orientation="vertical"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_details_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_details"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_tile_off"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_detail_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/night_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_detail_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/night_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_detail_webhook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/night_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_customize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/widget_config_title"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_gear"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
