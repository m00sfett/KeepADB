<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <!-- #761: header as on the other screens: close, title, then the step counter and the
         progress segments (built by OnboardingActivity). In the single-step mode the counter and
         the segments are gone and the title is the step's. -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_red"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/onboarding_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_header"
            android:contentDescription="@string/onboarding_close"
            android:padding="12dp"
            android:src="@drawable/ic_close" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/onboarding_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/onboarding_title"
                android:textColor="@color/title_yellow"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboarding_header_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/title_yellow"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/onboarding_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Body below the header: the page and the bottom bar share the system-bar insets. -->
    <LinearLayout
        android:id="@+id/onboarding_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/onboarding_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/onboarding_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/onboarding_page_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_keepadb"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/onboarding_page_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-condensed"
                    android:focusable="true"
                    android:textColor="@color/title_yellow"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/onboarding_page_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/night_text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/onboarding_page_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_red" />

        <!-- The three buttons are reordered and widened by OnboardingActivity when the display is
             narrow or the font large; here they sit side by side. -->
        <LinearLayout
            android:id="@+id/onboarding_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/onboarding_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_secondary"
                android:fontFamily="sans-serif-condensed"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/back"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />

            <View
                android:id="@+id/onboarding_bar_spacer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/onboarding_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:fontFamily="sans-serif-condensed"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/onboarding_later"
                android:textColor="@color/text_yellow"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/onboarding_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_primary"
                android:fontFamily="sans-serif-condensed"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/onboarding_next"
                android:textColor="@color/title_yellow"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
