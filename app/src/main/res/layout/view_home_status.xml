<?xml version="1.0" encoding="utf-8"?>
<!-- #957/#951/#952: the block of the main panel below the switch and its one-line description, in
     one place so the six activity_main.xml variants cannot drift. Top to bottom: the state, the
     reason (only when there is one; a tap target with an info mark when a long explanation
     exists), the action button (only when the user can act), the endpoint row (the whole row
     copies the adb connect command while an address is known, #951) and the "Connect a computer"
     link (#952). MainActivity renders it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- One polite live region around state and reason: a change of either is announced as one
         message, instead of two live regions talking over each other. -->
    <LinearLayout
        android:id="@+id/status_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/home_state_off"
            android:textColor="@color/night_text"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/status_reason_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/status_reason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:textColor="@color/night_muted"
                android:textSize="14sp"
                tools:text="Keep-Alive paused: Wi-Fi not trusted" />

            <ImageView
                android:id="@+id/status_reason_info"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/status_action"
        style="@style/Widget.KeepADB.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        tools:text="Decide…"
        tools:visibility="visible" />

    <!-- #1000: the Wifi-ADB timer, below the action so a reason and its button stay together.
         No timer: one "Timer" button that opens the duration list (#1032). Running: the end and
         the time left (in the live region's sibling, announced politely on change), then "+1 h"
         and "Timer off". KeepADBTimerSection renders it. -->
    <LinearLayout
        android:id="@+id/timer_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/timer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:textColor="@color/night_text"
            android:textSize="14sp"
            android:visibility="gone"
            android:drawableStart="@drawable/ic_timer"
            tools:text="Off at 14:35 · 42 min left"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/timer_start"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:textAllCaps="false"
                android:textColor="@color/text_yellow"
                android:text="@string/timer_action_open"
                android:textSize="15sp" />

            <Button
                android:id="@+id/timer_extend"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="16dp"
                android:text="@string/notification_action_extend"
                android:textAllCaps="false"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />

            <Button
                android:id="@+id/timer_no_limit"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="16dp"
                android:text="@string/timer_action_no_limit"
                android:textAllCaps="false"
                android:textColor="@color/text_yellow"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>


    <!-- The endpoint: "Port <port> @ <ip>", the row of the adb connect command (#951). -->
    <LinearLayout
        android:id="@+id/endpoint_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/endpoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="@string/endpoint_unavailable"
            android:textColor="@color/night_muted"
            android:textSize="15sp" />

        <!-- Decorative: the row is the control, and TalkBack gets its click label. -->
        <ImageView
            android:id="@+id/endpoint_copy_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_copy"
            android:visibility="gone" />
    </LinearLayout>

    <!-- #952: a text-style button below the endpoint, not another card. -->
    <Button
        android:id="@+id/connect_help"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-condensed"
        android:minHeight="48dp"
        android:paddingStart="0dp"
        android:paddingEnd="16dp"
        android:text="@string/connect_help_link"
        android:textAllCaps="false"
        android:textColor="@color/text_yellow"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
