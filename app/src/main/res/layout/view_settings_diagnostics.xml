<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostics Section -->
<!-- #1052: included by activity_settings.xml; the panel id and attributes are unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_diagnostics_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settings_diagnostics_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <!-- #736: decorative card icon, kept out of the accessibility tree since
             the adjacent title text already names the section. -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings_diagnostics" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/settings_diagnostics_title"
            android:textColor="@color/title_yellow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_diagnostics_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:fontFamily="sans-serif-condensed"
            android:text="+"
            android:textColor="@color/title_yellow"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settings_diagnostics_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/settings_diagnostics_subtext"
            android:textColor="@color/night_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_diagnostics_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_diagnostics_export"
            android:textColor="@color/text_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_issue_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_primary"
            android:contentDescription="@string/settings_issue_report_accessibility"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_issue_report_button"
            android:textColor="@color/title_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_general_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_primary"
            android:contentDescription="@string/settings_general_feedback"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_general_feedback"
            android:textColor="@color/title_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_reset_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_reset_app"
            android:textColor="@color/title_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
