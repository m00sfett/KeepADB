<?xml version="1.0" encoding="utf-8"?>
<!-- #761: "Customize" of the protection step: folds out the force row. #959: the comfort switch
     that sat here is gone; the "Balanced" card is the one control of by-name trust. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/onboarding_customize_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_clickable"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/onboarding_customize_show"
        android:textColor="@color/text_yellow"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/onboarding_customize_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- #768: the same force row as on the Protection page, driven by KeepADBForceSection. -->
        <include layout="@layout/view_force_panel" />
    </LinearLayout>
</LinearLayout>
