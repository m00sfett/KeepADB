<?xml version="1.0" encoding="utf-8"?>
<!-- #912: narrow and tall (about 2x2 at a large font): the main control on top, two square
     buttons side by side below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_root"
    android:padding="@dimen/widget_gap_half"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/widget_slot_hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/widget_slot_a"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/widget_slot_b"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
