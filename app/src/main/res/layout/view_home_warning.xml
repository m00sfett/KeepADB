<?xml version="1.0" encoding="utf-8"?>
<!-- #826: content and independent dismiss target; dismiss does not resolve the cause.
     #963: collapsed to one row (icon, title with chevron, action, close); a tap on the row opens
     the explanation below it. KeepADBWarningRow lays the four children out in this order and moves
     the action below the title when the title needs more than two lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_advice"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <de.hohnepeople.keepadb.KeepADBWarningRow
        android:id="@+id/warning_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:minHeight="48dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/home_warning_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:drawableEnd="@drawable/ic_expand_more"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/title_yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/home_warning_action"
            android:nextFocusForward="@id/home_warning_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-condensed"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/title_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/home_warning_dismiss"
            android:accessibilityTraversalAfter="@id/home_warning_action"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_close" />
    </de.hohnepeople.keepadb.KeepADBWarningRow>

    <!-- The explanation, aligned with the start of the title (icon 24dp + gap 12dp). -->
    <LinearLayout
        android:id="@+id/warning_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_warning_text"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/night_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
