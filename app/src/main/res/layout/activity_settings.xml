<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <!-- Back navigation, the privacy eye and the language button (#942) stay visible. -->
    <Toolbar
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/banner_red"
        android:contentInsetStart="0dp"
        android:contentInsetEnd="0dp"
        android:elevation="4dp"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_header"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/title_settings"
                android:textColor="@color/title_yellow"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- #725: privacy-mode eye, same button and state as on the main view. -->
            <include
                layout="@layout/view_privacy_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp" />

            <!-- #942: opens the language selection directly (replaces the overflow menu whose
                 only entry was Language). -->
            <ImageButton
                android:id="@+id/btn_settings_language"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_header"
                android:contentDescription="@string/settings_language_menu_label"
                android:padding="10dp"
                android:src="@drawable/ic_language" />

        </LinearLayout>
    </Toolbar>

    <ScrollView
        android:id="@+id/settings_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <de.hohnepeople.keepadb.KeepADBContentColumnLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- #761: re-opens the setup assistant (all of it); the summary shows the two settings
             it sets most. -->
        <LinearLayout
            android:id="@+id/settings_onboarding_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- #943: decorative icon, kept out of the accessibility tree; the title names it. -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings_assistant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/settings_onboarding_title"
                    android:textColor="@color/title_yellow"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_onboarding_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/night_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Permission Warning (if missing) -->
        <LinearLayout
            android:id="@+id/settings_permission_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/setup_title"
                android:textColor="@color/title_yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/settings_permission_warning"
                android:textColor="@color/night_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- #959: "Protection" is one row that opens its own page (ProtectionActivity); it holds
             what the collapsible Network card held (#519/#654). The summary shows the protection
             level and the number of trusted and blocked Wi-Fi networks; nothing else expands
             here. -->
        <LinearLayout
            android:id="@+id/settings_protection_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- #514: decorative card icon, kept out of the accessibility tree since the
                 adjacent title text already names the section. -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings_network" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/protection_title"
                    android:textColor="@color/title_yellow"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_protection_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/night_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <include layout="@layout/view_settings_webhook" />

        <include layout="@layout/view_settings_privacy" />

        <include layout="@layout/view_settings_misc" />

        <include layout="@layout/view_settings_automation" />

        <include layout="@layout/view_settings_backup" />

        <include layout="@layout/view_settings_diagnostics" />

        <!-- Version Section (#478: pinned, permanently visible, no panel frame/arrow) -->
        <LinearLayout
            android:id="@+id/settings_version_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/ground"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_version_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/settings_section_version"
                    android:textColor="@color/title_yellow"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_version_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_version_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/night_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/settings_version_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/night_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/settings_version_debug_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/settings_version_debug_badge"
                    android:contentDescription="@string/settings_version_debug_badge"
                    android:textColor="@color/primary_red"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/settings_license_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/settings_license_line"
                    android:textColor="@color/night_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/settings_website_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:contentDescription="@string/settings_website_link_accessibility"
                    android:fontFamily="sans-serif"
                    android:text="@string/settings_website_link"
                    android:textColor="@color/text_yellow"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </de.hohnepeople.keepadb.KeepADBContentColumnLayout>
    </ScrollView>
</LinearLayout>
