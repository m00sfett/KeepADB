<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header with Back Button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/banner_red"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="@font/fira_sans_condensed"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="←"
                android:textColor="@color/title_yellow"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/fira_sans_condensed"
                android:text="@string/title_settings"
                android:textColor="@color/title_yellow"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Permission Warning (if missing) -->
        <LinearLayout
            android:id="@+id/settings_permission_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fira_sans_condensed"
                android:text="@string/setup_title"
                android:textColor="@color/title_yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/fira_sans"
                android:text="@string/settings_permission_warning"
                android:textColor="@color/night_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- General / Keep-Alive Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/fira_sans_condensed"
                android:text="@string/settings_section_general"
                android:textColor="@color/title_yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/settings_keep_alive_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fira_sans_condensed"
                android:text="@string/keep_alive_toggle"
                android:textColor="@color/text_yellow"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/settings_keep_alive_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fira_sans"
                android:text="@string/keep_alive_subtext"
                android:textColor="@color/night_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Webhook Section -->
        <LinearLayout
            android:id="@+id/settings_webhook_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/fira_sans_condensed"
                android:text="@string/settings_webhook_title"
                android:textColor="@color/title_yellow"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/settings_webhook_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fira_sans_condensed"
                android:text="@string/settings_webhook_toggle"
                android:textColor="@color/text_yellow"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/fira_sans"
                android:text="@string/settings_webhook_subtext"
                android:textColor="@color/night_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fira_sans_condensed"
                android:text="@string/settings_webhook_url_label"
                android:textColor="@color/night_text"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/settings_webhook_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/panel_strong"
                android:fontFamily="monospace"
                android:hint="@string/settings_webhook_url_hint"
                android:inputType="textUri"
                android:padding="10dp"
                android:textColor="@color/night_text"
                android:textColorHint="@color/night_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/settings_webhook_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fira_sans"
                android:textColor="@color/link_red"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settings_webhook_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/settings_webhook_btn_clear" />

                <Button
                    android:id="@+id/settings_webhook_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_webhook_btn_save" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
