<?xml version="1.0" encoding="utf-8"?>
<!-- #913: the overview widget from about 4 cells wide: the information card (Wireless Debugging,
     Wi-Fi, Keep-Alive) on the left; on the right the webhook block (delivery state and the last
     accepted report, kept apart) above the auto-sync pill, the widget's only control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_root"
    android:orientation="horizontal"
    android:padding="@dimen/widget_gap_half">

    <LinearLayout
        android:id="@+id/widget_ov_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_gap_half"
        android:layout_weight="1.1"
        android:background="@drawable/bg_widget_tile_off"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_ov_delivery"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/widget_gap_half"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_tile_off"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_ov_delivery_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_ov_delivery_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_soft"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_ov_delivery_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_ov_delivery_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_soft" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_ov_sync"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_ov_sync_height"
            android:layout_margin="@dimen/widget_gap_half" />
    </LinearLayout>
</LinearLayout>
