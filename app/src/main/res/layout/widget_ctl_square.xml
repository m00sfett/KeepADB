<?xml version="1.0" encoding="utf-8"?>
<!-- #912: a secondary control as a square symbol button, no text: the state is the fill and the
     symbol variant; TalkBack reads "label, state" from the content description. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_tile_off"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:minWidth="48dp"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/widget_tile_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</LinearLayout>
