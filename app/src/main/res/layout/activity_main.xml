<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_red"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_keepadb" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/title_keepadb"
            android:textColor="@color/title_yellow"
            android:textSize="26sp"
            android:textStyle="bold" />


        <ImageButton
            android:id="@+id/btn_security_warnings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_header"
            android:padding="10dp"
            android:src="@drawable/ic_warning"
            android:visibility="gone" />
        <!-- #941: the same privacy eye as in the other title bars, left of the gear. -->
        <include
            layout="@layout/view_privacy_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp" />
        <ImageButton
            android:id="@+id/btn_open_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_header"
            android:contentDescription="@string/action_settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings_gear" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- #764: warnings first (system permission above everything), then the status. -->
                <include
                    android:id="@+id/warning_system"
                    layout="@layout/view_home_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />
                <!-- #826: display dismissal is independent of the force end action.
                     #963: one collapsed row like the other warnings (view_force_warning.xml). -->
                <include
                    android:id="@+id/force_warning_panel"
                    layout="@layout/view_force_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/warning_less_secure"
                    layout="@layout/view_home_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/warning_paused"
                    layout="@layout/view_home_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/warning_limited"
                    layout="@layout/view_home_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Feedback after a warning card was closed: a calm panel, undo first. -->
                <de.hohnepeople.keepadb.KeepADBSwipeDismissLayout
                    android:id="@+id/warning_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/warning_feedback_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/night_text"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/warning_undo"
                        style="@style/Widget.KeepADB.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/warnings_undo" />
                    <Button
                        android:id="@+id/warning_mute"
                        style="@style/Widget.KeepADB.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/warnings_mute" />
                </de.hohnepeople.keepadb.KeepADBSwipeDismissLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <Switch
                        android:id="@+id/toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:minHeight="48dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/toggle_label"
                        android:textColor="@color/text_yellow"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/toggle_subtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/toggle_subtext"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp" />

                    <!-- #957/#951/#952: state, reason, action, endpoint and the connect help link; one
                         shared block for all variants (view_home_status.xml). -->
                    <include
                        layout="@layout/view_home_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- #538: additional verified transports (VPN) beyond the
                         WLAN/LAN endpoint above; populated dynamically, one row per transport,
                         by MainActivity#renderTransportOverview(). Hidden while none apply, so
                         the common WLAN-only case looks exactly as before. -->
                    <LinearLayout
                        android:id="@+id/transport_overview_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/night_muted"
                            android:textSize="13sp"
                            tools:text="VPN: 10.*.*.*:5555 · last checked …" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border_red" />

                    <Switch
                        android:id="@+id/keep_alive_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/keep_alive_toggle"
                        android:textColor="@color/text_yellow"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/keep_alive_subtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/keep_alive_subtext"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/webhook_status_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/webhook_status_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/webhook_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp"
                        tools:text="@string/webhook_status_unconfigured" />

                    <!-- #1036: while Webhook Sync is on, one row per fact; URL and endpoint each get a
                         copy button when there is something to copy (design review in #1034). -->
                    <LinearLayout
                        android:id="@+id/webhook_status_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/webhook_url_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/webhook_url_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif"
                                android:textColor="@color/night_muted"
                                android:textSize="13sp"
                                tools:text="URL: http://example.com/register/s20" />

                            <ImageButton
                                android:id="@+id/webhook_url_copy"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/webhook_copy_url_action"
                                android:src="@drawable/ic_copy" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/webhook_endpoint_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/webhook_endpoint_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif"
                                android:textColor="@color/night_muted"
                                android:textSize="13sp"
                                tools:text="Last reported endpoint: 192.168.178.24:45149" />

                            <ImageButton
                                android:id="@+id/webhook_endpoint_copy"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/webhook_copy_endpoint_action"
                                android:src="@drawable/ic_copy" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/webhook_last_reported"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/night_muted"
                            android:textSize="13sp"
                            tools:text="Last reported: never" />
                    </LinearLayout>

                    <!-- #981: shown while Webhook Sync is not set up or off; opens its settings card. -->
                    <Button
                        android:id="@+id/webhook_status_action"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_yellow"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="@string/webhook_status_action_setup"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
