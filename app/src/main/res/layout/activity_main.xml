<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_red"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_keepadb" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/title_keepadb"
            android:textColor="@color/title_yellow"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_toggle_privacy_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_btn_header"
            android:contentDescription="@string/privacy_toggle_enable_accessibility"
            android:padding="8dp"
            android:src="@drawable/ic_privacy_eye" />

        <ImageButton
            android:id="@+id/btn_open_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_header"
            android:contentDescription="@string/action_settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings_gear" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/advice_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_advice_banner"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="4dp"
                android:paddingBottom="10dp"
                android:visibility="visible">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/advice_banner_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/advice_banner_text"
                        android:textColor="@color/night_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_dismiss_advice_banner"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/action_dismiss"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/setup_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/setup_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/setup_body"
                        android:textColor="@color/night_text"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:text="@string/setup_command"
                        android:textColor="@color/text_yellow"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/setup_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_primary"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/setup_refresh"
                        android:textColor="@color/title_yellow"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/battery_optimization_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/battery_optimization_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/battery_optimization_body"
                        android:textColor="@color/night_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_open_battery_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_primary"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/battery_optimization_button"
                        android:textColor="@color/title_yellow"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/notification_permission_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/notification_permission_panel_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/notification_permission_panel_body"
                        android:textColor="@color/night_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_open_notification_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_primary"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/notification_permission_settings_button"
                        android:textColor="@color/title_yellow"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/location_permission_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/location_permission_panel_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/location_permission_panel_body"
                        android:textColor="@color/night_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_grant_location_permission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_primary"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/location_permission_panel_grant_button"
                        android:textColor="@color/title_yellow"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/location_permission_fallback_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/location_permission_panel_fallback_body"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_trust_all_networks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_primary"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/location_permission_panel_fallback_button"
                        android:textColor="@color/title_yellow"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif"
                        android:text="@string/status_off"
                        android:textColor="@color/night_text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/endpoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="monospace"
                        android:text="@string/endpoint_unavailable"
                        android:textColor="@color/night_muted"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/toggle_label"
                        android:textColor="@color/text_yellow"
                        android:textSize="18sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border_red" />

                    <Switch
                        android:id="@+id/keep_alive_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/keep_alive_toggle"
                        android:textColor="@color/text_yellow"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/keep_alive_subtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/keep_alive_subtext"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border_red" />

                    <Switch
                        android:id="@+id/hide_notification_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/settings_hide_notification_toggle"
                        android:textColor="@color/text_yellow"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/hide_notification_subtext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/settings_hide_notification_subtext"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/webhook_status_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/webhook_status_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/webhook_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp"
                        tools:text="URL: http://example.com\nLast reported endpoint: 192.168.178.24:45149\nLast reported: never" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wifi_aps_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/wifi_aps_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- #492: the global trust-restriction switch moved back to Settings (it is a
                         security policy decision, not a list operation). Only its current status
                         stays visible here, next to the list the policy acts on. -->
                    <TextView
                        android:id="@+id/wifi_aps_trust_restriction_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_yellow"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <Switch
                        android:id="@+id/wifi_aps_trusted_only_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:text="@string/wifi_aps_trusted_only_toggle"
                        android:textColor="@color/text_yellow"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/wifi_aps_current_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_clickable"
                        android:orientation="vertical"
                        android:padding="12dp" />

                    <LinearLayout
                        android:id="@+id/wifi_aps_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/wifi_aps_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-condensed"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_yellow"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="@string/wifi_aps_show_less_button" />

                    <TextView
                        android:id="@+id/wifi_aps_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/wifi_aps_empty"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border_red" />

                    <!-- #492: optional SSID allowlist, in the same visual logic as the BSSID rows
                         above: a heading, the current value, then one row per listed entry. Only
                         visible while its opt-in in Settings is on. -->
                    <LinearLayout
                        android:id="@+id/wifi_ssids_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:fontFamily="sans-serif-condensed"
                            android:text="@string/wifi_ssids_title"
                            android:textColor="@color/title_yellow"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/wifi_ssids_warning"
                            android:textColor="@color/text_yellow"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/wifi_ssids_current_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_clickable"
                            android:orientation="vertical"
                            android:padding="12dp" />

                        <LinearLayout
                            android:id="@+id/wifi_ssids_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/wifi_ssids_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/wifi_ssids_empty"
                            android:textColor="@color/night_muted"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/border_red" />
                    </LinearLayout>

                    <!-- #485: block history moved here from Settings. #492 kept it: unlike the
                         removed "manage whitelist" entry it shows denials, not allowances, which
                         no other surface reports. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-condensed"
                        android:text="@string/home_security_actions_title"
                        android:textColor="@color/title_yellow"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/home_security_actions_body"
                        android:textColor="@color/night_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/wifi_aps_recently_blocked_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:fontFamily="sans-serif-condensed"
                        android:minHeight="48dp"
                        android:textColor="@color/text_yellow"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/webhook_setup_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="sans-serif-condensed"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="@string/webhook_setup_button"
                    android:textColor="@color/title_yellow"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
