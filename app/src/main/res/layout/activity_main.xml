<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/ground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/banner_red"
        android:padding="16dp"
        android:text="WLAN-ADB"
        android:textColor="@color/title_yellow"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="@font/fira_sans_condensed" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="WLAN-ADB"
            android:textColor="@color/night_text"
            android:textSize="20sp"
            android:fontFamily="@font/fira_sans" />

        <TextView
            android:id="@+id/endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/night_muted"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:text="Endpoint nicht verfügbar" />

        <Switch
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WLAN-ADB"
            android:textColor="@color/text_yellow"
            android:textSize="18sp"
            android:fontFamily="@font/fira_sans_condensed" />
    </LinearLayout>
</LinearLayout>
