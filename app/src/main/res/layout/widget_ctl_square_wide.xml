<?xml version="1.0" encoding="utf-8"?>
<!-- #912: a symbol button without text that is as wide as its slot (the stack's two buttons side
     by side, each 52 dp high); see widget_ctl_square for the one that stays square. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_tile_off"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:minWidth="48dp"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/widget_tile_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</LinearLayout>
