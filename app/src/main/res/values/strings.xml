    <string name="settings_section_trusted_network">Trusted Networks</string>
    <string name="settings_trusted_network_subtext">Optionally restrict automatic Keep-Alive re-enable to Wi-Fi networks you\'ve marked as trusted. Off by default. Manual toggling always works regardless of this setting.</string>
    <!-- Pure punctuation marker for the red warning badge; the spoken label is the separate
         *_warning_accessibility string next to it. -->
    <string name="settings_warning_marker">!</string>
    <string name="settings_trusted_network_warning_accessibility">Warning</string>
    <string name="settings_trusted_network_tradeoff_warning">Security versus convenience: turning this on largely disables \"Keep Wireless Debugging alive\". Android only lets an app read the current network\'s identity while KeepADB is open on screen — in the background the name and ID are hidden, and a hidden identity is never treated as trusted. Automatic re-enable then mostly stops working until you open the app.</string>
    <string name="settings_trusted_network_toggle">Restrict Keep-Alive to trusted networks</string>
    <string name="settings_trusted_ssid_warning">Weaker check: a network name (SSID) is freely chosen and is no proof of an access point. Any access point broadcasting an allowed name is trusted, including one imitating yours. Mainly useful if you run several access points under one name.</string>
    <string name="settings_trusted_ssid_warning_accessibility">Warning</string>
    <string name="settings_trusted_ssid_toggle">Also allow by network name (SSID)</string>
    <string name="settings_trusted_network_status_untrusted">Keep-Alive auto re-enable is paused: this Wi-Fi network isn\'t in your trusted list.</string>
    <string name="settings_trusted_network_status_identity_unavailable">Keep-Alive auto re-enable is paused: the current network\'s identity can\'t be determined.</string>
    <string name="settings_trusted_network_permission_title">Location permission needed</string>
    <string name="settings_trusted_network_permission_message">Android requires Location access before an app can read the current Wi-Fi network\'s name and ID. KeepADB uses this only to recognize trusted networks and never reads or stores your location.</string>
    <string name="settings_trusted_network_permission_grant">Grant</string>
