    <string name="setup_title">First-time setup</string>
    <string name="setup_body">Connect this device to a computer via USB with USB debugging enabled. First run \"adb devices\" on the computer to list connected devices and emulators, then use the exact serial number shown there.</string>
    <string name="setup_single_device_label">Only one device listed:</string>
    <string name="setup_command">adb shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="setup_multi_device_label">Several devices listed: target this one explicitly</string>
    <string name="setup_command_multi">adb -s &lt;device-serial&gt; shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="setup_multi_device_hint">Replace &lt;device-serial&gt; with the exact serial number \"adb devices\" showed for this device.</string>
