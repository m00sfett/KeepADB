    <string name="notification_permission_panel_title">Notifications</string>
    <string name="notification_permission_panel_body">With notifications enabled, you can see whether the KeepADB background service and Keep-Alive are running. If the connection drops, KeepADB lets you know right away. Wireless Debugging works fine without this permission too.</string>
