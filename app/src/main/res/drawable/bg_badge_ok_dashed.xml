<?xml version="1.0" encoding="utf-8"?>
<!-- #762: "trusted by name" - the badge of a trusted network whose access point itself is not
     trusted, outlined dashed so it differs from a trusted access point by more than the word. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <stroke
        android:width="1dp"
        android:color="@color/status_ok_green"
        android:dashGap="2dp"
        android:dashWidth="3dp" />
    <corners android:radius="@dimen/radius_small" />
</shape>
