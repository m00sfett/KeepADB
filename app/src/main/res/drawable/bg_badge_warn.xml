<?xml version="1.0" encoding="utf-8"?>
<!-- #762: status badge of the network list. No fill, 1dp outline in the text colour (@color/text_yellow);
     the word inside always carries the meaning, the colour only reinforces it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <stroke android:width="1dp" android:color="@color/text_yellow" />
    <corners android:radius="@dimen/radius_small" />
</shape>
