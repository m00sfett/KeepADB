<?xml version="1.0" encoding="utf-8"?>
<!-- #912: a control that is off or idle. Solid 1dp outline in the app's border red; the word on
     the tile carries the meaning, the outline only reinforces it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/panel" />
            <stroke android:width="2dp" android:color="@color/link_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel_strong" />
            <stroke android:width="1dp" android:color="@color/border_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
