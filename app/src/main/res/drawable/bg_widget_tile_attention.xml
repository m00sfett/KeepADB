<?xml version="1.0" encoding="utf-8"?>
<!-- #912: a control that needs the user (setup, permission, paused): dark red surface. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_ripple_on_dark">
    <item>
        <shape>
            <solid android:color="@color/widget_warn" />
            <corners android:radius="@dimen/widget_radius_tile" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/widget_radius_tile" />
        </shape>
    </item>
</ripple>
