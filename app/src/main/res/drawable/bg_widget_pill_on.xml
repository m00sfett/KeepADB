<?xml version="1.0" encoding="utf-8"?>
<!-- #912: a secondary control while it is on: flat yellow. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_ripple_on_light">
    <item>
        <shape>
            <solid android:color="@color/widget_on" />
            <corners android:radius="@dimen/widget_radius_tile" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/widget_radius_tile" />
        </shape>
    </item>
</ripple>
