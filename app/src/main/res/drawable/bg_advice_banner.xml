<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed advisory band: dark amber surface with a single hairline that
     separates it from the content below. One elevation cue only. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/advice_surface" />
        </shape>
    </item>
    <item
        android:top="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/advice_border" />
        </shape>
    </item>
</layer-list>
