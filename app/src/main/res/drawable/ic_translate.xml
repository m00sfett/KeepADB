<?xml version="1.0" encoding="utf-8"?>
<!-- #518: compact language/translation glyph for the Settings toolbar, replacing the former
     large in-content language section and its ic_globe icon (which rendered as a near-blank
     ellipse at small size, see issue #518). Depicts a Latin "A" (left) and a stylized CJK
     character stroke (right, an abstracted "文") side by side, the standard "translate"
     pictogram, so the icon reads unambiguously as a language switcher rather than a generic
     circle. Plain AOSP vector drawable, no external icon library. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/title_yellow">
    <!-- Latin "A" -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3.2,15L6.6,6L10,15" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4.4,12L8.8,12" />
    <!-- Abstracted CJK character ("文"-like): top stroke, crossbar and descending strokes -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M13.4,7.2L20.6,7.2" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M17,5.6L17,9.8" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M11.8,10L22.2,10" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M17,10L14,17.4" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M17,10L20.4,17.4" />
</vector>
