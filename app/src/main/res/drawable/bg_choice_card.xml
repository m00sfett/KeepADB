<?xml version="1.0" encoding="utf-8"?>
<!-- #761: a choice card of the setup assistant. The chosen card (activated) gets the 2dp yellow
     frame, so the choice is readable without colour as well: the radio indicator inside the card
     carries it too. Pressed and focused states match bg_card_clickable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/panel_strong" />
            <stroke android:width="1.5dp" android:color="@color/link_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/panel_strong" />
            <stroke android:width="2dp" android:color="@color/bright_yellow" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/panel_strong" />
            <stroke android:width="2dp" android:color="@color/title_yellow" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="@color/border_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
