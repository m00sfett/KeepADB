<?xml version="1.0" encoding="utf-8"?>
<!-- #818: selected (deep-link mark) and focused (keyboard/TalkBack ring) must stay apart.
     Focus ring: bright_yellow, 2dp. Selected: title_yellow, 2dp, amber-tinted fill. Both at once
     (listed before focused, otherwise focused would swallow the mark): amber fill, 3dp ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/panel_strong" />
            <stroke android:width="1.5dp" android:color="@color/link_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_focused="true">
        <shape>
            <solid android:color="@color/advice_surface" />
            <stroke android:width="3dp" android:color="@color/bright_yellow" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/panel_strong" />
            <stroke android:width="2dp" android:color="@color/bright_yellow" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/advice_surface" />
            <stroke android:width="2dp" android:color="@color/title_yellow" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel_strong" />
            <stroke android:width="1dp" android:color="@color/border_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
