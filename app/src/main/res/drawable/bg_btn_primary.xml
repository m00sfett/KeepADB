<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled: dark surface and muted border; first, so it wins over a pressed or
         focused state the button may still carry (Codex review). -->
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="@color/muted_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/muted_red" />
            <stroke android:width="1.5dp" android:color="@color/bright_yellow" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/muted_red" />
            <stroke android:width="2dp" android:color="@color/bright_yellow" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/banner_red" />
            <stroke android:width="1dp" android:color="@color/border_red" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
