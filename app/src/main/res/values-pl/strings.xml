    <string name="setup_title">Wstępna konfiguracja</string>
    <string name="setup_body">Podłącz to urządzenie do komputera przez USB z włączonym debugowaniem USB. Najpierw uruchom na komputerze "adb devices", aby wyświetlić listę podłączonych urządzeń i emulatorów, a następnie użyj dokładnego numeru seryjnego pokazanego tam.</string>
    <string name="setup_command">adb shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="setup_single_device_label">Widoczne tylko jedno urządzenie:</string>
    <string name="setup_multi_device_label">Widoczne kilka urządzeń: wskaż jawnie cel</string>
    <string name="setup_command_multi">adb -s &lt;device-serial&gt; shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="setup_multi_device_hint">Zastąp &lt;device-serial&gt; dokładnym numerem seryjnym, który "adb devices" pokazał dla tego urządzenia.</string>
    <string name="setup_state_offline_title">Urządzenie pokazuje "offline"?</string>
    <string name="setup_state_offline_body">Połączenie zostało przerwane. Podłącz ponownie kabel USB lub włącz ponownie debugowanie bezprzewodowe na telefonie, a następnie uruchamiaj "adb devices", aż stan zmieni się na "device".</string>
    <string name="setup_state_unauthorized_title">Urządzenie pokazuje "unauthorized"?</string>
    <string name="setup_state_unauthorized_body">Potwierdź monit o autoryzację debugowania na ekranie tego telefonu, a następnie uruchamiaj "adb devices", aż stan zmieni się na "device".</string>
