    <string name="setup_title">Wstępna konfiguracja</string>
    <string name="setup_body">KeepADB wymaga jednorazowego uprawnienia systemowego. Podłącz to urządzenie do komputera przez USB z włączonym debugowaniem USB, wykonaj poniższe polecenie i wróć do KeepADB.</string>
    <string name="setup_command">adb shell pm grant de.hohnepeople.keepadb android.permission.WRITE_SECURE_SETTINGS</string>
