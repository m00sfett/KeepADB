    <string name="setup_title">प्रारंभिक सेटअप</string>
    <string name="setup_body">KeepADB को एक बार सिस्टम अनुमति की आवश्यकता होती है। इस डिवाइस को USB डीबगिंग सक्षम करके USB द्वारा कंप्यूटर से कनेक्ट करें, नीचे दिए गए कमांड को चलाएं, और फिर KeepADB पर वापस आएं।</string>
    <string name="setup_command">adb shell pm grant de.hohnepeople.keepadb android.permission.WRITE_SECURE_SETTINGS</string>
