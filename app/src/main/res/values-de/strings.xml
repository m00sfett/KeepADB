    <string name="setup_title">Ersteinrichtung</string>
    <string name="setup_body">KeepADB benötigt einmalig eine Systemberechtigung. Verbinde dieses Gerät bei aktiviertem USB-Debugging per USB mit deinem Computer, führe dort den folgenden Befehl aus und kehre danach zu KeepADB zurück.</string>
    <string name="setup_command">adb shell pm grant de.hohnepeople.keepadb android.permission.WRITE_SECURE_SETTINGS</string>
