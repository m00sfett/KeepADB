    <string name="settings_trusted_network_status_identity_unavailable">Automatisch opnieuw inschakelen gepauzeerd: de identiteit van het huidige netwerk kan niet worden bepaald.</string>
    <string name="settings_trusted_network_permission_title">Locatietoestemming vereist</string>
    <string name="settings_trusted_network_permission_message">Android vereist locatietoegang voordat een app de naam en ID van het huidige Wi-Fi-netwerk kan lezen. KeepADB gebruikt dit alleen om vertrouwde netwerken te herkennen en leest of bewaart nooit uw locatie.</string>
