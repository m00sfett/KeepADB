    <string name="setup_body">KeepADB richiede un’autorizzazione di sistema una tantum. Collega questo dispositivo al computer tramite USB con il debug USB abilitato, esegui il comando sottostante e torna a KeepADB.</string>
    <string name="setup_command">adb shell pm grant de.hohnepeople.keepadb android.permission.WRITE_SECURE_SETTINGS</string>
