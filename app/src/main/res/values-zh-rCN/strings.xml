    <string name="setup_title">首次设置</string>
    <string name="setup_body">请启用 USB 调试并通过 USB 将此设备连接到电脑。先在电脑上运行 "adb devices" 列出已连接的设备和模拟器，然后使用其中显示的准确序列号。</string>
    <string name="setup_command">adb shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="setup_single_device_label">仅列出一台设备时：</string>
    <string name="setup_multi_device_label">列出多台设备时：明确指定目标设备</string>
