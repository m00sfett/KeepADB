    <string name="background_location_panel_title">已信任网络的后台检测</string>
    <string name="background_location_panel_body">为了在 Keep-Alive 于后台启动时也能识别你的已信任的 Wi-Fi（SSID/BSSID），KeepADB 需要将位置信息权限设为“始终允许”。KeepADB 绝不会确定或存储你设备的位置。请在下一个页面中打开“权限 › 位置信息”，并自行选择“始终允许”；KeepADB 无法替你授予此权限。未授予时，无法读取的网络永远不会被视为已信任。</string>
    <string name="background_location_settings_button">检查后台检测</string>
    <string name="background_location_dialog_later">稍后</string>
    <string name="background_location_status_granted">后台检测：已允许。即使 Keep-Alive 在后台启动，也能识别已信任的接入点。KeepADB 绝不会读取或存储你设备的位置。</string>
    <string name="background_location_status_missing">后台检测：受限。Keep-Alive 在后台启动时，Android 可能隐藏你连接的是哪个接入点；此时 KeepADB 会将该网络视为无法读取，在你打开应用之前不会自动开启无线调试。</string>
    <string name="background_location_status_missing_inactive">后台检测：此设置下不需要。Keep-Alive 在后台运行时，检查接入点或 Wi-Fi 名称需要此权限。</string>
    <string name="location_permission_panel_title">已信任网络需要位置权限</string>
